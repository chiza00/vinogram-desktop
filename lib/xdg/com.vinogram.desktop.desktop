[Desktop Entry]
Name=VinoGram Desktop
Comment=Desktop version of VinoGram - ToS breaking Telegram client
TryExec=VinoGram
Exec=env DESKTOPINTEGRATION=1 VinoGram -- %U
Icon=com.vinogram.desktop
Terminal=false
StartupWMClass=VinoGram
Type=Application
Categories=Chat;Network;InstantMessaging;Qt;
MimeType=x-scheme-handler/tg;x-scheme-handler/tonsite;
Keywords=tg;chat;im;messaging;messenger;sms;telegram;tdesktop;
Actions=quit;
DBusActivatable=true
SingleMainWindow=true
X-GNOME-UsesNotifications=true
X-GNOME-SingleWindow=true

[Desktop Action quit]
Exec=VinoGram -quit
Name=Quit VinoGram
Icon=application-exit
